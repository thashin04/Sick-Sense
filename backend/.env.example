# ----------------------------------------------------
# Example environment configuration for Sick-Sense
# Copy this file to .env and fill in the values below.
# ----------------------------------------------------

# Firebase Service Account Key File Location
# Download this JSON key from your Firebase Project Settings -> Service Accounts.
# Example: backend/firebase-key.json or absolute path C:\Users\...
FIREBASE_CREDENTIALS="backend/firebase-key.json" # this file needs to be downloaded

# Other required API keys
GOOGLE_API_KEY=""
GEMINI_API_KEY=""
